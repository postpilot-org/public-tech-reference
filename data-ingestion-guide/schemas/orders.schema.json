{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/postpilot-org/public-tech-reference/blob/main/data-ingestion-guide/schemas/orders.schema.json",
  "title": "Order record",
  "description": "One line of an orders_YYYYMMDD.jsonl file. Records that fail these rules are skipped by the pipeline, except an e-mail address in an ID field: those load, but must be fixed.",
  "type": "object",
  "required": ["id", "customer_id", "total_price", "currency", "shipping_address", "billing_address", "line_items", "created_at", "updated_at"],
  "properties": {
    "id": {
      "description": "Your unique order ID. Never an e-mail address.",
      "type": ["string", "integer"],
      "not": { "type": "string", "pattern": "@" },
      "examples": ["ord_9001"]
    },
    "customer_id": {
      "description": "The exact id of this customer in the customers file, including any hashing. Never an e-mail address.",
      "type": ["string", "integer"],
      "not": { "type": "string", "pattern": "@" },
      "examples": ["cust_1001"]
    },
    "total_price": {
      "description": "Order total, greater than 0. Leave refunds, returns and $0 orders out.",
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^\\s*\\+?(\\d*[1-9]\\d*\\.?\\d*|\\d*\\.\\d*[1-9]\\d*)\\s*$" }
      ],
      "examples": [129.99]
    },
    "currency": {
      "description": "ISO 4217 currency code, like USD.",
      "type": "string",
      "examples": ["USD"]
    },
    "email": {
      "description": "The customer's e-mail address. Listed in the docs, but the pipeline doesn't read it from the order.",
      "type": ["string", "null"],
      "examples": ["jane.doe@example.com"]
    },
    "coupon_codes": {
      "description": "Coupon codes used on the order.",
      "type": ["array", "null"],
      "items": { "type": "string" },
      "examples": [["WELCOME10"]]
    },
    "shipping_address": {
      "description": "Where the order shipped. Follows the same mailing-address rules as the customers file.",
      "$ref": "#/$defs/mailing_address"
    },
    "billing_address": {
      "description": "The billing address.",
      "$ref": "#/$defs/address"
    },
    "line_items": {
      "description": "The products on the order, at least one.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line_item" }
    },
    "created_at": {
      "description": "When the order was placed, ISO 8601.",
      "$ref": "#/$defs/timestamp",
      "examples": ["2025-03-27T09:55:00Z"]
    },
    "updated_at": {
      "description": "When the order last changed, ISO 8601. Change it whenever the order or its line items change.",
      "$ref": "#/$defs/timestamp",
      "examples": ["2025-03-27T10:10:00Z"]
    },
    "metadata": {
      "description": "Optional extras.",
      "type": ["object", "null"],
      "properties": {
        "tags": {
          "description": "Custom tags you can filter segments on.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "title": "ISO 8601 date",
      "type": "string",
      "pattern": "^\\d{4}-\\d{1,2}-\\d{1,2}([ T]\\d{1,2}:\\d{1,2}(:\\d{1,2}(\\.\\d{1,6})?)?)?(\\s*(Z|UTC|[+-]\\d{1,2}(:?\\d{2})?))?$"
    },
    "address": {
      "title": "Address",
      "type": "object",
      "required": ["email", "line1", "city", "state", "postal_code", "country_code"],
      "properties": {
        "id": { "description": "The customer's id, same as customer_id.", "type": ["string", "null"], "examples": ["cust_1001"] },
        "full_name": { "description": "First and last name, up to 40 characters.", "type": ["string", "null"], "examples": ["Jane Doe"] },
        "company": { "description": "Company name, up to 40 characters.", "type": ["string", "null"], "examples": ["Acme Co"] },
        "email": { "description": "E-mail address.", "type": "string", "examples": ["jane.doe@example.com"] },
        "line1": { "description": "Street address.", "type": "string", "examples": ["123 Main St"] },
        "line2": { "description": "Apartment, suite or unit.", "type": ["string", "null"], "examples": ["Apt 4B"] },
        "city": { "description": "City.", "type": "string", "examples": ["Irvine"] },
        "state": { "description": "State, province or region. 2-letter code for US addresses.", "type": "string", "examples": ["CA"] },
        "postal_code": { "description": "ZIP or postal code. US: 92618 or 92618-1234.", "type": "string", "examples": ["92618-1234"] },
        "country_code": { "description": "ISO 3166-1 alpha-2 country code, uppercase.", "type": "string", "pattern": "^[A-Z]{2}$", "examples": ["US"] }
      }
    },
    "mailing_address": {
      "title": "Mailing address",
      "allOf": [
        { "$ref": "#/$defs/address" },
        {
          "properties": {
            "full_name": { "maxLength": 40 },
            "company": { "maxLength": 40 },
            "line1": { "maxLength": 200, "pattern": "\\S" },
            "line2": { "maxLength": 200 },
            "city": { "maxLength": 200 },
            "state": { "maxLength": 200 }
          }
        },
        {
          "description": "Without a company",
          "if": { "required": ["company"], "properties": { "company": { "type": "string", "pattern": "\\S" } } },
          "else": {
            "required": ["full_name"],
            "properties": {
              "full_name": { "type": "string", "pattern": "([A-Za-z0-9_]+\\.*[\\t\\n\\f\\r ]+[A-Za-z0-9_]+)|(^Redacted$)" }
            }
          }
        },
        {
          "description": "US addresses",
          "if": { "required": ["country_code"], "properties": { "country_code": { "const": "US" } } },
          "then": {
            "properties": {
              "line1": { "maxLength": 64, "not": { "pattern": "^-+$" } },
              "line2": { "maxLength": 64 },
              "city": { "pattern": "\\S" },
              "state": { "pattern": "\\S", "maxLength": 2 },
              "postal_code": { "pattern": "^[0-9]{5}(-[0-9]{4})?$", "not": { "pattern": "^00000" } }
            }
          }
        },
        {
          "description": "UK addresses",
          "if": { "required": ["country_code"], "properties": { "country_code": { "enum": ["GB", "UK"] } } },
          "then": {
            "properties": {
              "postal_code": { "pattern": "^[A-Za-z0-9]{2,4}[\\t\\n\\f\\r ]?[A-Za-z0-9]{3}$" }
            }
          }
        }
      ]
    },
    "line_item": {
      "title": "Line item",
      "type": "object",
      "properties": {
        "id": { "description": "Product or SKU ID.", "type": ["string", "null"], "examples": ["li_1"] },
        "name": { "description": "Product name.", "type": ["string", "null"], "examples": ["T-Shirt"] },
        "price": { "description": "Unit price.", "type": ["number", "string", "null"], "examples": [29.99] },
        "quantity": { "description": "How many were bought.", "type": ["integer", "string", "null"], "examples": [2] }
      }
    }
  },
  "examples": [
    {
      "id": "ord_9001",
      "customer_id": "cust_1001",
      "total_price": 129.99,
      "currency": "USD",
      "email": "jane.doe@example.com",
      "coupon_codes": ["WELCOME10"],
      "shipping_address": {
        "id": "cust_1001",
        "full_name": "Jane Doe",
        "email": "jane.doe@example.com",
        "line1": "123 Main St",
        "line2": "Apt 4B",
        "city": "Irvine",
        "state": "CA",
        "postal_code": "92618-1234",
        "country_code": "US"
      },
      "billing_address": {
        "id": "cust_1001",
        "full_name": "Jane Doe",
        "email": "jane.doe@example.com",
        "line1": "123 Main St",
        "city": "Irvine",
        "state": "CA",
        "postal_code": "92618-1234",
        "country_code": "US"
      },
      "line_items": [
        { "id": "li_1", "name": "T-Shirt", "price": 29.99, "quantity": 2 },
        { "id": "li_2", "name": "Jeans", "price": 70.01, "quantity": 1 }
      ],
      "created_at": "2025-03-27T09:55:00Z",
      "updated_at": "2025-03-27T10:10:00Z"
    }
  ]
}
